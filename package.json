{
  "name": "cutaway",
  "version": "1.0.0",
  "description": "Digital business card API: NestJS, GraphQL, Prisma, PostgreSQL, Docker",
  "private": true,
  "license": "MIT",
  "author": "Nikita Yuskov",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node src/seed/run-seed.ts",
    "db:setup": "npm run prisma:generate && npm run db:migrate && npm run db:seed",
    "test": "jest --config test/jest.config.js",
    "test:unit": "jest --config test/jest.config.js --selectProjects unit",
    "test:e2e": "jest --config test/jest.config.js --selectProjects e2e --runInBand",
    "test:cov": "jest --config test/jest.config.js --coverage",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "security:audit": "npm audit --audit-level=high",
    "test:security": "jest --config test/jest.config.js --selectProjects unit --testPathPatterns security",
    "security": "./scripts/security.sh",
    "test:docker": "./scripts/test.sh"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "^11.2.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dataloader": "^2.2.3",
    "dotenv": "^17.4.2",
    "graphql": "^16.15.0",
    "graphql-depth-limit": "^1.1.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "@graphql-tools/utils": "13.2.2"
  }
}
