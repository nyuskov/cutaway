# PostgreSQL (Docker Compose publishes it on localhost:5434)
DATABASE_URL=postgresql://cutaway:cutaway@localhost:5434/cutaway?schema=public
PORT=3001

# Apollo Sandbox and introspection are part of the public card.
# Set to "false" to hide the schema in hardened deployments.
GRAPHQL_INTROSPECTION=true
GRAPHQL_SANDBOX=true

# Comma-separated list of allowed origins. Empty or "*" reflects the request origin.
CORS_ORIGINS=*
