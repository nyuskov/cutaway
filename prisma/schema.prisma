datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

model Profile {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  headline    String
  description String
  location    String?
  email       String?
  avatarUrl   String?
  isPrimary   Boolean      @default(false)
  contacts    Contact[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isPrimary])
}

enum ContactKind {
  GITHUB
  LINKEDIN
  HH
  TELEGRAM
  EMAIL
  WEBSITE
}

model Contact {
  id        String      @id @default(cuid())
  profileId String
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      ContactKind
  label     String
  url       String
  sortOrder Int         @default(0)

  @@unique([profileId, url])
  @@index([profileId])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Skill {
  id        String     @id @default(cuid())
  profileId String
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  String
  level     SkillLevel
  sortOrder Int        @default(0)

  @@unique([profileId, name])
  @@index([profileId])
}

model Experience {
  id           String        @id @default(cuid())
  profileId    String
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  position     String
  startDate    DateTime      @db.Date
  endDate      DateTime?     @db.Date
  location     String?
  summary      String?
  sortOrder    Int           @default(0)
  achievements Achievement[]

  @@index([profileId, startDate])
}

model Achievement {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  text         String
  sortOrder    Int        @default(0)

  @@index([experienceId])
}

model Project {
  id            String    @id @default(cuid())
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  slug          String    @unique
  name          String
  description   String?
  url           String
  repositoryUrl String?
  startedAt     DateTime? @db.Date
  tags          String[]  @default([])
  sortOrder     Int       @default(0)

  @@index([profileId])
}
